# Anthropic API key used only by the server-side report generation route.
# Current code reads AMAZIN_CYBER_REPORT; rename this later to ANTHROPIC_API_KEY for clarity.
AMAZIN_CYBER_REPORT=

# Supabase public browser/server configuration. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

